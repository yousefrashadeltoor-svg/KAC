# Add these to Vercel -> Project -> Settings -> Environment Variables. Never commit real values.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=https://YOUR-PROJECT.vercel.app/api?action=callback
SESSION_SECRET=GENERATE_A_RANDOM_64_CHARACTER_SECRET

# Optional: REQUIRED ONLY for genuine captured live chat via signed webhooks.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional background schedule runner. Requires Redis above and a SEPARATELY deployed Cloudflare Durable Objects Worker.
BACKGROUND_WORKER_URL=https://kac-background.YOUR-CLOUDFLARE-SUBDOMAIN.workers.dev/
BACKGROUND_WORKER_SECRET=GENERATE_ANOTHER_RANDOM_64_CHARACTER_SECRET

# Add to Cloudflare Worker runtime Variables & Secrets (NOT to this .env on GitHub):
# BACKGROUND_WORKER_SECRET = same as Vercel secret above
# VERCEL_BACKGROUND_ENDPOINT = https://YOUR-PROJECT.vercel.app/api?action=background_execute
